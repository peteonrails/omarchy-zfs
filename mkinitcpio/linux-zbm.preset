# omarchy-zfs: guarantee a plain kernel + initramfs pair in /boot.
#
# ZFSBootMenu boots a BE by kexec'ing /boot/vmlinuz-* with its matching
# /boot/initramfs-*.img from the pool. Omarchy's limine flow builds only a
# UKI on the ESP — the initramfs goes into a temp dir and never lands in
# /boot, so ZBM kexecs the kernel with no initrd and the boot dies with
# "VFS: Unable to mount root fs on unknown-block(0,0)".
#
# Preset files are sourced as bash: pick whichever supported kernel is
# installed. On systems that also keep the stock preset this rebuilds the
# same image path — harmless.

# This preset deliberately does NOT set ALL_config. It exists only to
# guarantee the plain kernel+initramfs pair, built from the normal config
# chain (mkinitcpio.conf + conf.d, including our zz-omarchy-zfs.conf drop-in
# that puts `zfs` before `filesystems`).
#
# The pool keyfile is embedded afterwards by omarchy-zfs-embed-pool-key, which
# rebuilds this same image with `mkinitcpio -c`. It used to be embedded here
# via ALL_config, but the keyed and stock builds write the SAME image path and
# `mkinitcpio -P` walks presets in glob order — which is locale-dependent. In
# C collation (what arch-chroot and pacman hooks use) linux-zbm.preset sorts
# BEFORE linux.preset, so the keyless image won and boot asked for the
# passphrase twice.
PRESETS=()

for _k in linux linux-lts; do
  if [[ -e /boot/vmlinuz-${_k} ]]; then
    ALL_kver="/boot/vmlinuz-${_k}"
    default_image="/boot/initramfs-${_k}.img"
    PRESETS=('default')
    break
  fi
done
unset _k
