# Block kernel upgrades when zfs-dkms cannot build against the candidate kernel.
# Without this guard, pacman -Syu silently produces an unbootable initramfs
# (the kernel package's own 90-mkinitcpio-install.hook regenerates initramfs
# without the ZFS module if zfs-dkms's Linux-Maximum is below the new kernel).
#
# The trigger is the path every kernel package ships, not a list of package
# names. Every name list went stale: Omarchy 4.0.4 added five kernels this hook
# did not cover, and 4.5 added linux-omarchy-eevdf. A name-based trigger also
# needed a glob that would not fire on linux-firmware, which does not exist.
# usr/lib/modules/*/vmlinuz matches exactly the packages that install a kernel
# image and nothing else. Path triggers on Install/Upgrade match the files in
# the incoming package, so this runs before the new kernel lands.
#
# NeedsTargets passes the matched paths on stdin. Each one carries the exact
# kernel version (usr/lib/modules/7.2.15-2-omarchy/vmlinuz), so the check reads
# the version of the kernel actually being installed.
#
# To bypass (only if you're recovering or know what you're doing):
#   OMARCHY_SKIP_ZFS_KERNEL_CHECK=1 sudo -E pacman -Syu

[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Verifying ZFS-on-ZBM kernel compatibility...
When = PreTransaction
Exec = /usr/bin/omarchy-zfs-kernel-compat-check candidate
NeedsTargets
AbortOnFail
