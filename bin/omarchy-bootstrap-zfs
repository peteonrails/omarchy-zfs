#!/bin/bash

# omarchy:summary=Bootstrap a fresh Omarchy install on ZFS-on-root with ZFSBootMenu (run from the archzfs LTS ISO).
# omarchy:args=[--dry-run] [--resume]
# omarchy:requires-sudo=true
#
# Runs from r-maerz/archlinux-lts-zfs (https://github.com/r-maerz/archlinux-lts-zfs/releases)
# — an archlinux ISO with the LTS kernel and prebuilt zfs-linux-lts modules.
# Performs the work the stock Quattro installer can't: partitioning,
# zpool/dataset creation, pacstrap, chroot config, ZBM install, EFI boot
# entry. Then installs Omarchy + omarchy-zfs as packages and finalizes with
# omarchy-apply-system / omarchy-provision-user. Also runs fully offline from
# the omarchy-zfs ISO (OMARCHY_ZFS_OFFLINE=1, see iso/ in the repo).
#
# Why the LTS-zfs ISO instead of stock Arch: kernel and ZFS module versions
# are atomically paired by archzfs's package release. No DKMS rebuild
# lottery on `pacman -Syu`, no kernel-ahead-of-zfs-dkms trap that bricked
# the workstation on 2026-05-04.
#
# This is the automated equivalent of docs/zfs-install.md.
#
# Usage:
#   omarchy-bootstrap-zfs                     # interactive
#   omarchy-bootstrap-zfs --dry-run           # print actions, change nothing
#   omarchy-bootstrap-zfs --resume            # resume from last completed stage
#
# Scope:
#   - Single disk OR multi-disk (mirror, raidz1, raidz2, raidz3)
#   - Fresh pool OR import of an existing pool (Appendix A dual-boot)
#   - Encrypted whole-pool with passphrase, file-based key for password sync
#   - Single ESP on the first member disk (ESP-mirror is a follow-up)
#   - Arch-wiki-style dataset layout: zroot/ROOT/default + zroot/data + zroot/var
#   - linux-lts kernel + prebuilt zfs-linux-lts (atomic version pairing)

set -euo pipefail

# ============================================================================
# Constants
# ============================================================================

readonly POOL_NAME="zroot"
# Arch-wiki dataset layout — discoverable by ZBM (ROOT/<be>) and granular
# enough that snapshot/rollback can target individual subsystems.
readonly DATASET_ROOT_CONTAINER="${POOL_NAME}/ROOT"
readonly DATASET_ROOT="${DATASET_ROOT_CONTAINER}/default"
readonly DATASET_DATA="${POOL_NAME}/data"
readonly DATASET_HOME="${DATASET_DATA}/home"
readonly DATASET_USER_ROOT="${DATASET_DATA}/root"
readonly DATASET_VAR="${POOL_NAME}/var"
readonly DATASET_VARLOG="${DATASET_VAR}/log"
readonly DATASET_VARLOG_JOURNAL="${DATASET_VARLOG}/journal"
readonly DATASET_VARCACHE="${DATASET_VAR}/cache"
readonly DATASET_VARTMP="${DATASET_VAR}/tmp"
readonly DATASET_VARLIB="${DATASET_VAR}/lib"
readonly DATASET_VARLIB_DOCKER="${DATASET_VARLIB}/docker"
readonly DATASET_VARLIB_LIBVIRT="${DATASET_VARLIB}/libvirt"
readonly DATASET_VARLIB_MACHINES="${DATASET_VARLIB}/machines"
readonly DATASET_KEYSTORE="${POOL_NAME}/keystore"

readonly KEYFILE_TMP="/tmp/omarchy-bootstrap.key"
readonly KEYFILE_FINAL="/etc/zfs/keys/${POOL_NAME}.key"

readonly STATE_FILE="/tmp/omarchy-bootstrap-zfs.state"
readonly VARS_FILE="/tmp/omarchy-bootstrap-zfs.vars"
readonly LOG_FILE="/tmp/omarchy-bootstrap-zfs.log"

# Latest stable release EFI, served via redirect by the ZBM project.
readonly ZBM_RELEASE_URL="https://get.zfsbootmenu.org/efi"

# Pointer to the recommended ISO for users who run this from the wrong
# environment (stock Arch ISO without ZFS modules). Documentation only.
readonly RECOMMENDED_ISO_URL="https://github.com/r-maerz/archlinux-lts-zfs/releases"

readonly MNT="/mnt"
readonly ESP_MOUNT="${MNT}/boot/efi"

# Offline mode: set by the omarchy-zfs ISO (see iso/ in the repo). Every
# package comes from the ISO's baked-in mirrors, the ZBM EFI comes from
# OMARCHY_ZBM_EFI, and Omarchy itself is installed as packages in pacstrap
# rather than fetched from the network.
readonly OFFLINE="${OMARCHY_ZFS_OFFLINE:-0}"

# ============================================================================
# Globals (populated by stages)
# ============================================================================

DRY_RUN=0
RESUME=0
USE_EXISTING_POOL=0
TARGET_DISKS=()
POOL_TOPOLOGY=""
ESP_DEVICE=""
ZFS_PARTITIONS=()
HOSTNAME_VAL=""
TIMEZONE_VAL=""
LOCALE_VAL=""
USERNAME_VAL=""

# ============================================================================
# Logging + helpers
# ============================================================================

log()  { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >> "$LOG_FILE"; }
say()  { printf '\n\033[1;36m▸ %s\033[0m\n' "$*"; log "$*"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$*" >&2; log "WARN: $*"; }
die()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; log "DIE: $*"; exit 1; }

run() {
  log "RUN: $*"
  if (( DRY_RUN )); then
    printf '\033[1;90m[dry-run]\033[0m %s\n' "$*"
    return 0
  fi
  "$@"
}

confirm() {
  local prompt="$1"
  if (( DRY_RUN )); then
    printf '\033[1;90m[dry-run]\033[0m would prompt: %s\n' "$prompt"
    return 0
  fi
  gum confirm "$prompt"
}

# Stage results (chosen disks, partition paths, username, …) live in shell
# globals, so `--resume` in a fresh process would skip the stages that set
# them and run later stages against empty values — the second VM run's
# partition stage no-op'd exactly this way. Persist the globals alongside
# the stage list and reload them on resume.
save_vars() {
  declare -p POOL_TOPOLOGY TARGET_DISKS ESP_DEVICE ZFS_PARTITIONS \
    USE_EXISTING_POOL HOSTNAME_VAL TIMEZONE_VAL LOCALE_VAL USERNAME_VAL \
    > "$VARS_FILE"
}

load_vars() {
  # declare -p emits function-local declares when sourced inside a function;
  # force globals.
  [[ -f $VARS_FILE ]] && source <(sed 's/^declare /declare -g /' "$VARS_FILE")
}

mark_done() { echo "$1" >> "$STATE_FILE"; save_vars; }
is_done()   { [[ -f $STATE_FILE ]] && grep -qFx "$1" "$STATE_FILE"; }

stage() {
  local name="$1"
  local fn="stage_${name}"
  if (( RESUME )) && is_done "$name"; then
    say "Skipping ${name} (already done)"
    return 0
  fi
  say "${name//_/ }"
  "$fn"
  mark_done "$name"
}

# ============================================================================
# Argument parsing
# ============================================================================

usage() {
  sed -n '3,/^$/p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

parse_args() {
  while (( $# )); do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --resume)  RESUME=1 ;;
      -h|--help) usage 0 ;;
      *) die "Unknown argument: $1" ;;
    esac
    shift
  done
}

# ============================================================================
# Stage 1: preflight
# ============================================================================

stage_preflight() {
  [[ $EUID -eq 0 ]] || die "Must run as root"
  [[ -d /sys/firmware/efi ]] || die "UEFI mode required (Secure Boot must be off)"

  if ! command -v gum &>/dev/null; then
    say "Installing gum on the live ISO"
    run pacman -Sy --noconfirm --needed gum
  fi

  if (( ! OFFLINE )) && ! ping -c1 -W2 archlinux.org &>/dev/null; then
    die "No network. Set up wifi (iwctl) or ethernet first."
  fi

  # /etc/hostid must exist BEFORE the pool is created or imported, and gets
  # copied into the target before its initramfs is built. The zfs initramfs
  # hook refuses to import a pool whose last-import hostid doesn't match —
  # the same mismatch class that broke the Phase-3 on-metal migration.
  if [[ ! -s /etc/hostid ]]; then
    run zgenhostid "$(hostid)"
  fi

  log "preflight ok: euid=$EUID, efi=yes, offline=$OFFLINE"
}

# ============================================================================
# Stage 2: verify ZFS is available on the live ISO
#
# We require the user to boot the archlinux-lts-zfs ISO (r-maerz), which
# ships with the LTS kernel + prebuilt zfs-linux-lts modules. archzfs
# guarantees atomic kernel/zfs version pairing, so there's nothing to
# build here — the modules just need to be loaded.
#
# If zpool isn't available, we abort with a clear pointer at the right
# ISO. Building zfs-dkms-git on a stock Arch ISO is technically possible
# (and what we did before) but it traded freshness for portability;
# requiring the LTS-zfs ISO is cleaner.
# ============================================================================

stage_install_zfs_on_iso() {
  if ! modinfo zfs &>/dev/null || ! command -v zpool &>/dev/null; then
    die "ZFS not available on this ISO.

This bootstrap requires the archlinux-lts-zfs ISO (LTS kernel + prebuilt
zfs-linux-lts modules) — not the stock Arch live ISO.

Download from: $RECOMMENDED_ISO_URL

Boot that ISO and re-run this script."
  fi

  say "ZFS available on this ISO"
  run modprobe zfs
}

# ============================================================================
# Stage 3: choose pool mode (fresh or existing)
# ============================================================================

stage_choose_pool_mode() {
  local importable
  importable=$(zpool import 2>/dev/null | awk '/^   pool:/ {print $2}' || true)

  if [[ -n $importable ]]; then
    say "Detected importable pools:"
    echo "$importable" | sed 's/^/  /'
    if confirm "Add Omarchy as a boot environment on an existing pool?"; then
      USE_EXISTING_POOL=1
    fi
  fi

  if (( USE_EXISTING_POOL )); then
    log "mode: existing pool"
  else
    log "mode: fresh pool"
  fi
}

# ============================================================================
# Stage 4 (fresh): disk + topology selection
# ============================================================================

stage_disk_selection() {
  if (( USE_EXISTING_POOL )); then return 0; fi

  say "Pick pool topology"
  POOL_TOPOLOGY=$(printf '%s\n' single mirror raidz1 raidz2 raidz3 \
    | gum choose --header "Topology")
  [[ -n $POOL_TOPOLOGY ]] || die "No topology selected"

  local min
  case "$POOL_TOPOLOGY" in
    single) min=1 ;;
    mirror) min=2 ;;
    raidz1) min=3 ;;
    raidz2) min=4 ;;
    raidz3) min=5 ;;
  esac

  local disk_rows
  disk_rows=$(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk"')
  if [[ -z $disk_rows ]]; then
    lsblk -dpno NAME,SIZE,TYPE >&2
    die "No whole disks found (need lsblk TYPE=disk; see device list above)"
  fi

  local choices=""
  if (( min == 1 )); then
    # Single topology: a plain picker, where Enter means "this one". The
    # multi-select UI made Enter submit an EMPTY selection unless the disk
    # was first marked with Space — the natural keystroke trap that killed
    # the first ISO VM run.
    say "Pick the disk (it also gets the ESP)"
    choices=$(echo "$disk_rows" | gum choose --header "Disk")
  else
    say "Pick ${min}+ disks (Space to mark, Enter to confirm; first disk also gets the ESP)"
    local attempt
    for attempt in 1 2 3; do
      choices=$(echo "$disk_rows" \
        | gum choose --no-limit --header "Disks (mark ≥${min} with Space, then Enter)")
      [[ -n $choices ]] && break
      warn "Nothing selected — mark disks with Space, then press Enter"
    done
  fi
  [[ -n $choices ]] || die "No disks selected"

  mapfile -t TARGET_DISKS < <(echo "$choices" | awk '{print $1}')
  (( ${#TARGET_DISKS[@]} >= min )) || die "$POOL_TOPOLOGY needs at least $min disks"

  warn "All data on these disks will be DESTROYED:"
  printf '  %s\n' "${TARGET_DISKS[@]}"
  confirm "Wipe and partition?" || die "Aborted"
}

# ============================================================================
# Stage 5 (fresh): partition disks
# ============================================================================

stage_partition_disks() {
  if (( USE_EXISTING_POOL )); then return 0; fi

  ZFS_PARTITIONS=()

  for i in "${!TARGET_DISKS[@]}"; do
    local disk="${TARGET_DISKS[$i]}"
    say "Partitioning $disk"
    run wipefs -af "$disk"
    run sgdisk -Z "$disk"

    if (( i == 0 )); then
      # ESP on first disk
      run sgdisk -n "1:0:+1G" -t "1:EF00" -c "1:EFI" "$disk"
      run sgdisk -n "2:0:0"   -t "2:BF00" -c "2:zfs" "$disk"
      ESP_DEVICE="$(_partition_path "$disk" 1)"
      ZFS_PARTITIONS+=("$(_partition_path "$disk" 2)")
    else
      # Subsequent disks: one ZFS partition spanning whole disk
      run sgdisk -n "1:0:0" -t "1:BF00" -c "1:zfs" "$disk"
      ZFS_PARTITIONS+=("$(_partition_path "$disk" 1)")
    fi
  done

  # Only probe the disks we touched: a bare partprobe rescans every block
  # device, and parted errors out on the live ISO's own CD-ROM hybrid
  # partition table ("Can't have a partition outside the disk!"), killing
  # the script under set -e. Observed in the first ISO VM run.
  run partprobe "${TARGET_DISKS[@]}"
  sleep 2

  say "Formatting ESP at $ESP_DEVICE"
  run mkfs.fat -F32 -n EFI "$ESP_DEVICE"
}

_partition_path() {
  # Compose the partition device path. NVMe/SDA differ in how partitions are named.
  local disk="$1" num="$2"
  if [[ $disk =~ nvme|mmcblk|loop ]]; then
    echo "${disk}p${num}"
  else
    echo "${disk}${num}"
  fi
}

# ============================================================================
# Stage 6 (fresh): create pool
# ============================================================================

stage_create_pool() {
  if (( USE_EXISTING_POOL )); then return 0; fi

  say "Set the pool encryption passphrase (also used as your login password)"
  local pass1 pass2
  while :; do
    pass1=$(gum input --password --header "Passphrase (≥8 chars)")
    pass2=$(gum input --password --header "Confirm")
    [[ ${#pass1} -ge 8 && $pass1 == "$pass2" ]] && break
    warn "Mismatch or too short — try again"
  done

  if (( DRY_RUN )); then
    log "would write keyfile $KEYFILE_TMP"
  else
    umask 077
    printf '%s' "$pass1" > "$KEYFILE_TMP"
  fi

  local vdev_spec
  case "$POOL_TOPOLOGY" in
    single) vdev_spec="${ZFS_PARTITIONS[0]}" ;;
    mirror) vdev_spec="mirror ${ZFS_PARTITIONS[*]}" ;;
    raidz1) vdev_spec="raidz ${ZFS_PARTITIONS[*]}" ;;
    raidz2) vdev_spec="raidz2 ${ZFS_PARTITIONS[*]}" ;;
    raidz3) vdev_spec="raidz3 ${ZFS_PARTITIONS[*]}" ;;
  esac

  say "Creating pool $POOL_NAME ($POOL_TOPOLOGY)"
  # -R /mnt sets the altroot so child datasets mount under /mnt without
  # rewriting their mountpoint properties. After reboot, no altroot is
  # active and the same datasets mount at their literal mountpoints.
  # shellcheck disable=SC2086
  run zpool create -f \
    -o ashift=12 \
    -o autotrim=on \
    -O acltype=posixacl -O xattr=sa -O dnodesize=auto \
    -O compression=zstd \
    -O normalization=formD \
    -O relatime=on -O atime=off \
    -O mountpoint=none \
    -O canmount=off \
    -O encryption=aes-256-gcm \
    -O keyformat=passphrase \
    -O keylocation="file://$KEYFILE_TMP" \
    -R "$MNT" \
    "$POOL_NAME" $vdev_spec
}

# ============================================================================
# Stage 7 (existing): import pool, load key
# ============================================================================

stage_import_existing_pool() {
  if ! (( USE_EXISTING_POOL )); then return 0; fi

  say "Importing $POOL_NAME"
  run zpool import -f -N "$POOL_NAME"

  if [[ $(zfs get -H -o value keystatus "$POOL_NAME") != "available" ]]; then
    say "Loading pool key"
    if (( DRY_RUN )); then
      log "would prompt for $POOL_NAME passphrase"
    else
      zfs load-key "$POOL_NAME"
    fi
  fi

  if zfs list -H -o name | grep -qx "$DATASET_ROOT_CONTAINER"; then
    die "$DATASET_ROOT_CONTAINER already exists. Refusing to clobber."
  fi

  # Find the existing ESP — caller's other OS will have one mounted somewhere
  if [[ -z $ESP_DEVICE ]]; then
    ESP_DEVICE=$(lsblk -no NAME,FSTYPE,PATH | awk '$2=="vfat"{print $3; exit}')
    [[ -n $ESP_DEVICE ]] || die "Could not auto-detect ESP. Set ESP_DEVICE env var."
    say "Reusing detected ESP: $ESP_DEVICE"
  fi
}

# ============================================================================
# Stage 8: dataset layout (Arch-wiki-style)
#
# Pool root carries the encryption (set in stage_create_pool); all child
# datasets inherit. Mountpoints are stored in the pool itself so
# zfs-mount-generator can reconstruct the tree at boot.
#
#   zroot/ROOT/default        →  /            (the boot environment)
#   zroot/data/home           →  /home
#   zroot/data/root           →  /root
#   zroot/var/log             →  /var/log
#   zroot/var/log/journal     →  /var/log/journal   (posixacl for systemd)
#   zroot/var/cache           →  /var/cache
#   zroot/var/tmp             →  /var/tmp
#   zroot/var/lib/{docker,libvirt,machines}        (per-service, opt rollback)
#   zroot/keystore            →  /etc/zfs/keys
# ============================================================================

stage_create_datasets() {
  # Container datasets (no mount, no children inherit a mountpoint)
  run zfs create -o mountpoint=none -o canmount=off "$DATASET_ROOT_CONTAINER"
  run zfs create -o mountpoint=none -o canmount=off "$DATASET_DATA"
  run zfs create -o mountpoint=none -o canmount=off "$DATASET_VAR"
  run zfs create -o mountpoint=none -o canmount=off "$DATASET_VARLIB"

  # Boot environment — ZBM expects <pool>/ROOT/<name> with mountpoint=/ +
  # canmount=noauto. The "default" suffix is the BE name.
  run zfs create -o mountpoint=/ -o canmount=noauto "$DATASET_ROOT"

  # User-data datasets (shared across boot environments by default)
  run zfs create -o mountpoint=/home "$DATASET_HOME"
  run zfs create -o mountpoint=/root "$DATASET_USER_ROOT"

  # /var subtree — separate datasets so a system rollback doesn't nuke
  # logs / pacman cache, and per-service rollback is possible.
  run zfs create -o mountpoint=/var/log "$DATASET_VARLOG"
  run zfs create -o mountpoint=/var/log/journal -o acltype=posixacl "$DATASET_VARLOG_JOURNAL"
  run zfs create -o mountpoint=/var/cache "$DATASET_VARCACHE"
  run zfs create -o mountpoint=/var/tmp "$DATASET_VARTMP"
  run zfs create -o mountpoint=/var/lib/docker "$DATASET_VARLIB_DOCKER"
  run zfs create -o mountpoint=/var/lib/libvirt "$DATASET_VARLIB_LIBVIRT"
  run zfs create -o mountpoint=/var/lib/machines "$DATASET_VARLIB_MACHINES"

  # Encryption key storage — mounted at /etc/zfs/keys so the keyfile is
  # available post-import for the password-sync logic in install.sh.
  if ! zfs list -H -o name | grep -qx "$DATASET_KEYSTORE"; then
    run zfs create -o mountpoint=/etc/zfs/keys "$DATASET_KEYSTORE"
  fi

  # Pool-level boot pointer for ZBM convenience.
  run zpool set "bootfs=$DATASET_ROOT" "$POOL_NAME"
}

# ============================================================================
# Stage 9: mount filesystems for pacstrap
# ============================================================================

stage_mount_filesystems() {
  run mkdir -p "$MNT"
  run mount -t zfs -o zfsutil "$DATASET_ROOT" "$MNT"

  # Mount everything else by letting ZFS resolve mountpoints relative to /mnt
  # via altroot. zpool was created with -R /mnt in stage_create_pool, so
  # `zfs mount -a` mounts each dataset at "$MNT/<mountpoint>".
  run zfs mount -a

  run mkdir -p "$ESP_MOUNT"
  run mount "$ESP_DEVICE" "$ESP_MOUNT"
}

# ============================================================================
# Stage 10: pacstrap base + LTS kernel + prebuilt zfs-linux-lts
#
# The archzfs LTS ISO ships archzfs configured. pacstrap with -C carries
# the ISO's pacman.conf into the chroot, so archzfs is reachable for
# `linux-lts` + `zfs-linux-lts` install (atomically version-paired by
# archzfs's own packaging) and remains configured for future updates.
# ============================================================================

stage_pacstrap() {
  # The target's initramfs is generated during this transaction (via the
  # kernel's hook — and, when omarchy-zfs is in the list, our ensure-
  # mkinitcpio self-heal hook). The hostid must already be in place or the
  # resulting initramfs can't import the pool.
  if ! (( DRY_RUN )); then
    install -Dm644 /etc/hostid "$MNT/etc/hostid"
  fi

  local pkgs=(
    base base-devel
    linux-firmware
    sudo git iwd
    efibootmgr dosfstools
  )
  if (( OFFLINE )); then
    # Quattro way: Omarchy and the ZFS layer are packages. Installing them in
    # the same pacstrap transaction means omarchy-zfs's PostTransaction hooks
    # (ensure-mkinitcpio, snapper guard) fire inside the target immediately,
    # so the very first initramfs already carries the zfs hook.
    #
    # Kernel: stock `linux` + zfs-dkms-git, matching Omarchy proper and the
    # ISO's own live env. archzfs's prebuilt zfs-linux-lts pins an exact
    # kernel Arch rotates out too fast to bake into an ISO, and even its
    # zfs-dkms release lags current kernels; the git snapshot (built into the
    # ISO's [zfs-offline] mirror) tracks them. The omarchy-zfs kernel guard
    # prevents future skew.
    pkgs+=(linux linux-headers zfs-dkms-git zfs-utils-git omarchy omarchy-zfs)

    # The full Omarchy manifest, not just the meta-package's dependency
    # closure: things like docker live only in the package lists, and
    # omarchy-apply-system assumes they're installed (its docker.sh died on
    # the missing docker group in the first ISO VM run). The stock installer
    # pacstraps these same lists; the ISO bakes them into the live env.
    local list
    for list in /usr/share/omarchy-iso/omarchy-base.packages \
                /usr/share/omarchy-iso/omarchy-other.packages; do
      [[ -r $list ]] || continue
      mapfile -t -O "${#pkgs[@]}" pkgs < <(grep -hvE '^#|^\s*$' "$list")
    done
    say "pacstrap full Omarchy + ZFS layer from the ISO's offline mirrors (zfs-dkms builds once, in-chroot)"
  else
    # archzfs LTS live ISO: prebuilt modules, atomically paired by archzfs.
    pkgs+=(linux-lts linux-lts-headers zfs-linux-lts zfs-utils)
    say "pacstrap (≈3 min — prebuilt packages, no DKMS build)"
  fi

  run pacstrap -K "$MNT" "${pkgs[@]}"

  # Mirror the ISO's archzfs repo configuration into the chroot so future
  # `pacman -Syu` runs there pull paired linux-lts + zfs-linux-lts updates
  # from archzfs as they're published.
  if ! grep -q '^\[archzfs\]' "$MNT/etc/pacman.conf"; then
    if (( DRY_RUN )); then
      log "would configure archzfs repo in chroot"
    else
      if grep -q '^\[archzfs\]' /etc/pacman.conf; then
        awk '/^\[archzfs\]/,/^\[/{ if (/^\[/ && !/^\[archzfs\]/) exit; print }' /etc/pacman.conf \
          | sudo tee -a "$MNT/etc/pacman.conf" >/dev/null
      else
        # Offline ISO: the live pacman.conf only knows the baked-in mirrors.
        # Write the canonical archzfs section so post-boot `pacman -Syu` keeps
        # pulling atomically paired linux-lts + zfs-linux-lts updates.
        cat <<'EOF' | sudo tee -a "$MNT/etc/pacman.conf" >/dev/null

[archzfs]
Server = https://archzfs.com/$repo/$arch
Server = https://zxcvfdsa.com/archzfs/$repo/$arch
EOF
      fi
      arch-chroot "$MNT" pacman-key --recv-keys DDF7DB817396A49B2A2723F7403BD972F75D9D76 2>/dev/null || true
      arch-chroot "$MNT" pacman-key --lsign-key DDF7DB817396A49B2A2723F7403BD972F75D9D76 2>/dev/null || true
    fi
  fi
}

# ============================================================================
# Stage 11: genfstab + ZFS entries
# ============================================================================

stage_fstab() {
  if (( DRY_RUN )); then
    log "would genfstab and append ZFS entries"
    return 0
  fi

  # genfstab captures the ESP. ZFS datasets are intentionally NOT in fstab —
  # zfs-mount-generator (driven by zfs-zed + the cachefile) handles them at
  # boot, and double-mount conflicts are easy to introduce by mixing fstab
  # entries with zfs-mount-generator-managed mounts.
  genfstab -U "$MNT" | grep -v ' zfs ' >> "$MNT/etc/fstab"
}

# ============================================================================
# Stage 12: chroot config (locale, hostname, user, networking, keystore, cachefile)
# ============================================================================

prompt_chroot_basics() {
  HOSTNAME_VAL=$(gum input --header "Hostname" --value "omarchy")
  TIMEZONE_VAL=$(gum input --header "Timezone (e.g. America/New_York)" --value "UTC")
  LOCALE_VAL=$(gum input  --header "Locale" --value "en_US.UTF-8")
  # No logname default: on a live ISO it is always "root", and an accepted
  # default silently made root the target user (first ISO VM run).
  USERNAME_VAL=$(gum input --header "Username (your daily login, not root)" --placeholder "user")
  while [[ -z $USERNAME_VAL || $USERNAME_VAL == root ]]; do
    warn "Pick a non-root username"
    USERNAME_VAL=$(gum input --header "Username (your daily login, not root)" --placeholder "user")
  done
  [[ -n $HOSTNAME_VAL && -n $TIMEZONE_VAL && -n $LOCALE_VAL && -n $USERNAME_VAL ]] \
    || die "All chroot prompts are required"
}

stage_chroot_config() {
  prompt_chroot_basics

  say "Writing system identity"
  if ! (( DRY_RUN )); then
    echo "$HOSTNAME_VAL" > "$MNT/etc/hostname"
    arch-chroot "$MNT" ln -sf "/usr/share/zoneinfo/$TIMEZONE_VAL" /etc/localtime
    arch-chroot "$MNT" hwclock --systohc
    echo "$LOCALE_VAL UTF-8" > "$MNT/etc/locale.gen"
    arch-chroot "$MNT" locale-gen
    echo "LANG=$LOCALE_VAL" > "$MNT/etc/locale.conf"
    echo "KEYMAP=us"        > "$MNT/etc/vconsole.conf"
  fi

  say "Networking (systemd-networkd + iwd)"
  if ! (( DRY_RUN )); then
    arch-chroot "$MNT" systemctl enable systemd-networkd.service systemd-resolved.service iwd.service
    mkdir -p "$MNT/etc/systemd/network" "$MNT/etc/iwd"
    cat > "$MNT/etc/systemd/network/20-wired.network" <<EOF
[Match]
Name=en*

[Network]
DHCP=yes
DNSSEC=no
EOF
    cat > "$MNT/etc/systemd/network/25-wireless.network" <<EOF
[Match]
Name=wl*

[Network]
DHCP=yes
DNSSEC=no
EOF
    cat > "$MNT/etc/iwd/main.conf" <<EOF
[General]
EnableNetworkConfiguration=false

[Network]
NameResolvingService=systemd
EOF
    # Not via arch-chroot: it bind-mounts the host's resolv.conf (already a
    # symlink to stub-resolv.conf) over the target's, so ln sees source and
    # destination as the same file and fails. Write the target path directly.
    ln -sfn /run/systemd/resolve/stub-resolv.conf "$MNT/etc/resolv.conf"
  fi

  say "Creating user $USERNAME_VAL"
  if ! (( DRY_RUN )); then
    # Idempotent for --resume re-runs of this stage.
    arch-chroot "$MNT" id -u "$USERNAME_VAL" &>/dev/null ||
      arch-chroot "$MNT" useradd -m -G wheel,audio,video,input,storage,lp,sys,network,users,rfkill "$USERNAME_VAL"
    # Login password = encryption passphrase (install.sh's password-sync code does
    # the same thing on first run; we set it here so the user can log in immediately
    # after reboot in case install.sh password-sync is skipped via OMARCHY_CHROOT_INSTALL).
    if [[ -r $KEYFILE_TMP ]]; then
      printf '%s\n%s\n' "$(cat "$KEYFILE_TMP")" "$(cat "$KEYFILE_TMP")" \
        | arch-chroot "$MNT" passwd "$USERNAME_VAL"
    fi
    echo '%wheel ALL=(ALL) NOPASSWD: ALL' > "$MNT/etc/sudoers.d/wheel"
    chmod 440 "$MNT/etc/sudoers.d/wheel"
  fi

  say "Persisting key into ${DATASET_KEYSTORE} and switching to file-based keylocation"
  if ! (( DRY_RUN )); then
    install -Dm600 "$KEYFILE_TMP" "$MNT$KEYFILE_FINAL"
    # Run change-key inside the chroot so the file:// path resolves correctly.
    # The kernel ZFS state is shared between live ISO and chroot, so this
    # updates the same imported pool either way.
    arch-chroot "$MNT" zfs change-key -o "keylocation=file://$KEYFILE_FINAL" "$POOL_NAME"
  fi

  say "Setting zpool cachefile"
  run zpool set "cachefile=/etc/zfs/zpool.cache" "$POOL_NAME"
  if ! (( DRY_RUN )); then
    mkdir -p "$MNT/etc/zfs"
    cp /etc/zfs/zpool.cache "$MNT/etc/zfs/zpool.cache"
  fi

  say "Setting org.zfsbootmenu:commandline"
  run zfs set "org.zfsbootmenu:commandline=quiet splash rw" "$DATASET_ROOT"
}

# ============================================================================
# Stage 13: install ZBM (prebuilt EFI to /boot/efi/EFI/zbm)
#
# We install the prebuilt release EFI for an immediate working boot. Omarchy's
# install.sh deposits the branded hooks at /etc/zfsbootmenu/hooks/ but only
# rebuilds via `generate-zbm` if zfs-bootmenu is installed (AUR). Branding is
# therefore deferred — re-run `omarchy-refresh-zbm` after first boot once the
# user has yay + zfsbootmenu via the AUR.
# ============================================================================

stage_install_zbm() {
  local zbm_dir="${ESP_MOUNT}/EFI/zbm"
  run mkdir -p "$zbm_dir"

  # Prefer a locally provided image (the omarchy-zfs ISO bakes one in at
  # /usr/share/omarchy-zfs/zbm/vmlinuz.EFI and points OMARCHY_ZBM_EFI at it),
  # falling back to the network for stock live environments.
  if [[ -r ${OMARCHY_ZBM_EFI:-} ]]; then
    say "Installing bundled ZBM EFI image ($OMARCHY_ZBM_EFI)"
    run install -m644 "$OMARCHY_ZBM_EFI" "$zbm_dir/vmlinuz.EFI"
  else
    (( OFFLINE )) && die "Offline install but no bundled ZBM image at \${OMARCHY_ZBM_EFI:-unset}"
    say "Downloading prebuilt ZBM EFI image"
    if ! (( DRY_RUN )); then
      curl -fsSL --location -o "$zbm_dir/vmlinuz.EFI" "$ZBM_RELEASE_URL" \
        || die "Failed to download ZBM EFI image from $ZBM_RELEASE_URL"
    fi
  fi

  # Stage Omarchy's branding hooks into the chroot now so the post-install
  # `generate-zbm` (run by install.sh) picks them up immediately if the user
  # later installs zfsbootmenu via AUR.
  if ! (( DRY_RUN )); then
    mkdir -p "$MNT/etc/zfsbootmenu/hooks/setup.d" "$MNT/etc/zfsbootmenu/hooks/load-key.d"
    cat > "$MNT/etc/zfsbootmenu/config.yaml" <<EOF
Global:
  ManageImages: true
  BootMountPoint: /boot/efi
  InitCPIO: true
  PreHooksDir: /etc/zfsbootmenu/hooks
Components:
  Enabled: false
EFI:
  Enabled: true
  ImageDir: /boot/efi/EFI/zbm
  Versions: 2
Kernel:
  CommandLine: quiet loglevel=0 zbm.skip_hooks=
EOF
  fi
}

# ============================================================================
# Stage 14: EFI boot entry for ZBM
# ============================================================================

stage_efi_boot_entry() {
  local first_disk="${TARGET_DISKS[0]:-}"
  local part_num=1

  if (( USE_EXISTING_POOL )); then
    # Derive disk + partition from ESP_DEVICE (e.g. /dev/nvme0n1p1 → nvme0n1, 1)
    first_disk=$(lsblk -no PKNAME "$ESP_DEVICE" | head -1)
    [[ -n $first_disk ]] || die "Could not derive parent disk from $ESP_DEVICE"
    first_disk="/dev/$first_disk"
    part_num=$(echo "$ESP_DEVICE" | grep -oE '[0-9]+$')
  fi

  if efibootmgr | grep -q "Omarchy (ZBM)"; then
    warn "EFI entry 'Omarchy (ZBM)' already exists — skipping"
    return 0
  fi

  say "Adding EFI boot entry"
  run efibootmgr --create \
    --disk "$first_disk" \
    --part "$part_num" \
    --label "Omarchy (ZBM)" \
    --loader '\EFI\zbm\vmlinuz.EFI'
}

# ============================================================================
# Stage 15: install + finalize Omarchy (Quattro package flow)
#
# Quattro is served entirely from packages. Offline, `omarchy` and
# `omarchy-zfs` were already installed by pacstrap from the ISO's mirrors;
# online we add the official [omarchy] repo and install them here. Either
# way, finalization mirrors what the stock ISO's orchestrator does:
# `omarchy-apply-system` as root, then `omarchy-provision-user` as the user.
# On ZFS our package's guards make both safe (snapper configs, mkinitcpio
# hook, EFI boot order).
# ============================================================================

readonly OMARCHY_GPG_KEY="40DFB630FF42BCFFB047046CF0134EE680CAC571"

stage_run_omarchy_install() {
  if (( DRY_RUN )); then
    log "would install omarchy + omarchy-zfs and run apply-system/provision-user in chroot"
    return 0
  fi

  if ! (( OFFLINE )); then
    if ! grep -q '^\[omarchy\]' "$MNT/etc/pacman.conf"; then
      say "Configuring the official [omarchy] repo in the target"
      cat <<'EOF' >> "$MNT/etc/pacman.conf"

[omarchy]
Server = https://pkgs.omarchy.org/$arch
EOF
      arch-chroot "$MNT" pacman-key --recv-keys "$OMARCHY_GPG_KEY" 2>/dev/null || true
      arch-chroot "$MNT" pacman-key --lsign-key "$OMARCHY_GPG_KEY" 2>/dev/null || true
    fi
    if ! grep -q '^\[omarchy-zfs\]' "$MNT/etc/pacman.conf"; then
      # omarchy-zfs is AUR-source; the project serves a small unsigned binary
      # repo so a chroot install needs no makepkg. Verifiable: same content as
      # https://aur.archlinux.org/packages/omarchy-zfs.
      cat <<'EOF' >> "$MNT/etc/pacman.conf"

[omarchy-zfs]
SigLevel = Optional TrustAll
Server = https://omarchy-zfs.com/repo/any
EOF
    fi
    say "Installing Omarchy + ZFS layer packages"
    run arch-chroot "$MNT" pacman -Sy --noconfirm omarchy omarchy-zfs
  fi

  say "Finalizing system (omarchy-apply-system)"
  run arch-chroot "$MNT" omarchy-apply-system --install-user "$USERNAME_VAL" --first-install

  say "Provisioning user $USERNAME_VAL (omarchy-provision-user)"
  run arch-chroot "$MNT" sudo -u "$USERNAME_VAL" omarchy-provision-user --first-install
}

# ============================================================================
# Stage 16: finalize
# ============================================================================

stage_finalize() {
  say "Unmounting"
  if ! (( DRY_RUN )); then
    sync
    umount -R "$MNT" || warn "Some mounts didn't unmount cleanly"
    zpool export "$POOL_NAME" || warn "Pool export failed (will be auto-imported on boot regardless)"
  fi

  printf '\n\033[1;32m✓ Bootstrap complete.\033[0m\n\n'
  cat <<EOF
Next:
  - reboot
  - ZFSBootMenu shows the encryption passphrase prompt (your $POOL_NAME passphrase)
  - select ${DATASET_ROOT}
  - log in as $USERNAME_VAL with the same passphrase

Kernel + ZFS: linux-lts paired with prebuilt zfs-linux-lts. Future updates
flow atomically — when archzfs publishes a new linux-lts/zfs-linux-lts
pair, \`omarchy-update\` (or plain \`pacman -Syu\`) pulls them together.

Branding follow-up (after first boot):
  - install yay (or paru)
  - yay -S zfsbootmenu
  - sudo generate-zbm    # rebuilds ZBM with the Omarchy hooks staged in /etc/zfsbootmenu/hooks

Logs: $LOG_FILE
EOF
}

# ============================================================================
# Main
# ============================================================================

main() {
  parse_args "$@"
  : > "$LOG_FILE"
  if (( RESUME )); then
    load_vars
  else
    : > "$STATE_FILE"
    rm -f "$VARS_FILE"
  fi

  stage preflight
  stage install_zfs_on_iso
  stage choose_pool_mode

  if (( USE_EXISTING_POOL )); then
    stage import_existing_pool
  else
    stage disk_selection
    stage partition_disks
    stage create_pool
  fi

  stage create_datasets
  stage mount_filesystems
  stage pacstrap
  stage fstab
  stage chroot_config
  stage install_zbm
  stage efi_boot_entry
  stage run_omarchy_install
  stage finalize
}

main "$@"
