#!/bin/bash

# omarchy:summary=Make ZFS datasets mount and unlock at boot via zfs-mount-generator.
# omarchy:requires-sudo=true
# omarchy:args=[--pool NAME] [--dry-run] [--yes]
#
# The problem this solves (issue #1, @oemsysadm): a machine with a btrfs root
# and ZFS on /home boots with nothing loading the pool's encryption key and
# nothing mounting the datasets. omarchy-zfs did nothing about it, because its
# install scriptlet returns early when / is not ZFS.
#
# The fix is not a hand-written unit. zfs-utils already ships
# zfs-mount-generator, which reads /etc/zfs/zfs-list.cache/<pool> at boot and
# generates a .mount unit per dataset PLUS the zfs-load-key@<dataset>.service
# units needed to unlock them, ordered correctly. It escapes dataset names
# properly, so pools with hyphens work:
#
#   zfs-load-key@zbackup-enc-lil\x2dnas\x2dx-forgejo.service
#
# A hand-rolled zfs-load-key@.service template cannot do that: you write the
# instance name yourself, and a '-' in a dataset name silently becomes a '/'.
#
# The generator is opt-in per pool, and that is the whole bug. It only acts on
# pools that have a file in /etc/zfs/zfs-list.cache/, and nothing creates that
# file for you. This creates it, makes sure zfs-zed is running to keep it
# current, primes it, and then verifies units actually got generated instead of
# assuming they did.

set -uo pipefail

CACHE_DIR="/etc/zfs/zfs-list.cache"
GEN_DIR="/run/systemd/generator"
POOL=""
DRY_RUN=false
ASSUME_YES=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pool)    POOL="${2:-}"; shift ;;
    --dry-run) DRY_RUN=true ;;
    --yes|-y)  ASSUME_YES=true ;;
    -h|--help)
      sed -n '3,6p' "$0" | sed 's/^# *//'
      exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

die()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
say()  { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$*" >&2; }
ok()   { printf '  \033[1;32mok\033[0m   %s\n' "$*"; }

run() {
  if $DRY_RUN; then printf '\033[1;90m[dry-run]\033[0m %s\n' "$*"; return 0; fi
  "$@"
}

command -v zfs >/dev/null   || die "zfs is not installed"
command -v zpool >/dev/null || die "zpool is not installed"
[[ -x /usr/lib/systemd/system-generators/zfs-mount-generator ]] ||
  die "zfs-mount-generator is missing. It ships with zfs-utils; install or reinstall that first."

mapfile -t pools < <(zpool list -H -o name 2>/dev/null)
(( ${#pools[@]} )) || die "no pools are imported, so there is nothing to set up"

if [[ -n $POOL ]]; then
  printf '%s\n' "${pools[@]}" | grep -qxF "$POOL" || die "pool '$POOL' is not imported"
  pools=("$POOL")
fi

say "Pools to configure: ${pools[*]}"
echo
echo "This will, for each pool:"
echo "  - enable and start zfs-zed (it keeps the cache current)"
echo "  - create $CACHE_DIR/<pool>, which opts the pool into the generator"
echo "  - prime the cache by setting and clearing a user property"
echo "  - reload systemd and report the units that were generated"
echo
echo "Datasets already mounted from /etc/fstab should be removed from fstab"
echo "afterwards. Two mechanisms mounting the same path race each other."
echo

if ! $DRY_RUN && ! $ASSUME_YES; then
  read -rp "Proceed? [y/N] " reply
  [[ ${reply,,} == y* ]] || exit 0
fi

# --- zed ---------------------------------------------------------------------
# The cache file is written by the history_event-zfs-list-cacher.sh zedlet,
# which only runs if zed is running. zfs-utils ships the zedlet symlink already
# enabled in /etc/zfs/zed.d, so this is the only missing piece.
if systemctl is-active --quiet zfs-zed.service; then
  ok "zfs-zed is running"
else
  say "Enabling zfs-zed"
  run systemctl enable --now zfs-zed.service || warn "could not start zfs-zed"
fi

run mkdir -p "$CACHE_DIR"

for pool in "${pools[@]}"; do
  echo
  say "Pool: $pool"
  cache="$CACHE_DIR/$pool"

  if [[ -s $cache ]]; then
    ok "cache already populated ($(wc -l < "$cache") datasets)"
  else
    run touch "$cache"
    # Priming: the zedlet reacts to history events. Setting a user property and
    # then inheriting it emits two, costs nothing, and leaves no trace. A no-op
    # `zfs set` of a real property would be riskier for no benefit.
    run zfs set "org.omarchy-zfs:listcache=priming" "$pool"
    run zfs inherit "org.omarchy-zfs:listcache" "$pool"

    if ! $DRY_RUN; then
      for _ in {1..10}; do
        [[ -s $cache ]] && break
        sleep 0.5
      done
    fi

    if $DRY_RUN; then
      :
    elif [[ -s $cache ]]; then
      ok "cache written ($(wc -l < "$cache") datasets)"
    else
      warn "$cache is still empty."
      warn "  zed may not have seen the event. Try: sudo systemctl restart zfs-zed, then re-run."
      continue
    fi
  fi

  # Report which datasets in this pool need a key, since those are the ones the
  # reporter cared about and the ones most likely to be silently missing.
  while IFS=$'\t' read -r ds keyloc; do
    [[ -z $ds || $keyloc == "-" || $keyloc == "none" ]] && continue
    ok "$ds unlocks from $keyloc"
  done < <(zfs list -H -o name,keylocation -r "$pool" 2>/dev/null | awk -F'\t' '$2!="none" && $2!="-"')
done

# --- regenerate --------------------------------------------------------------
echo
say "Reloading systemd so the generator runs"
run systemctl daemon-reload

$DRY_RUN && { echo; say "Dry run: nothing was changed."; exit 0; }

# --- verify ------------------------------------------------------------------
# Verifying rather than assuming: a silent no-op is exactly the failure the
# reporter hit, and it looks identical to success until the next reboot.
echo
say "Units generated"
found=0
for pool in "${pools[@]}"; do
  while read -r unit; do
    ok "$(basename "$unit")"
    found=1
  done < <(grep -rlE "^What=$pool(/|$)" "$GEN_DIR"/*.mount 2>/dev/null)
  while read -r unit; do
    ok "$(basename "$unit")"
    found=1
  done < <(ls "$GEN_DIR"/zfs-load-key@* 2>/dev/null | grep -F "$pool")
done

if (( found )); then
  echo
  echo "Reboot to confirm. If a dataset holds /home, check that it is mounted"
  echo "before the display manager starts, or the greeter will accept your"
  echo "password and then fail to open a session."
else
  warn "no units were generated."
  warn "  Check: systemd-analyze verify, and that $CACHE_DIR/<pool> is non-empty."
  exit 1
fi
