#!/bin/bash

# omarchy:summary=Rebuild the in-pool boot images with the pool keyfile embedded (alias of omarchy-zfs-boot-images).
# omarchy:requires-sudo=true
#
# Until 1.2.0 this rebuilt /boot/initramfs-{linux,linux-lts}.img with the pool
# key embedded, and nothing else. omarchy-zfs-boot-images now stages and builds
# the image for every kernel that has a ZFS module, Omarchy's linux-omarchy
# included, embedding the key the same way. This name stays for callers that
# still use it, such as the bootstrap script on an older ISO.

exec omarchy-zfs-boot-images "$@"
