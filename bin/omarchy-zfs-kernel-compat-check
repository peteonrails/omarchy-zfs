#!/bin/bash

# omarchy:summary=Verify zfs-dkms can build against the installed or candidate Linux kernel.
# omarchy:args=[installed|candidate]
#
# Exits 0 if the check passes (or the system is non-ZFS, or data is missing).
# Exits 1 if the check fails — kernel exceeds zfs-dkms's Linux-Maximum.
#
# Used by:
#   - /usr/share/libalpm/hooks/90-omarchy-zfs-kernel-guard.hook (PreTransaction, mode=candidate)
#   - by hand (mode=installed), to ask whether every kernel on disk is covered.
#     omarchy-refresh-zbm no longer gates on it: omarchy-zfs-boot-images checks
#     each kernel's module and leaves out the ones without, rather than letting
#     one uncovered kernel stop the rebuild for the rest.
#
# Bypass with OMARCHY_SKIP_ZFS_KERNEL_CHECK=1 if you're absolutely sure (DANGEROUS).

set -e

mode="${1:-installed}"

# Non-ZFS systems are never blocked by this check.
#
# "Uses ZFS" is deliberately broader than "boots from ZFS". A machine with a
# btrfs root and ZFS on /home (or on a data pool) is just as dependent on
# zfs.ko building for the running kernel: without it the pool cannot import at
# boot, and a missing /home means the greeter authenticates you and then fails
# to open a session — indistinguishable from a wrong password. Gating this
# check on the root filesystem alone left exactly that hole.
zfs_in_use() {
  [[ "$(findmnt -no FSTYPE / 2>/dev/null || true)" == "zfs" ]] && return 0
  # Any imported pool. (Covers /home-only and secondary data pools.)
  [[ -n "$(zpool list -H -o name 2>/dev/null)" ]] && return 0
  # A DKMS zfs package installed means the user intends ZFS to work on this
  # kernel, even if no pool happens to be imported right now — which is
  # precisely the state a broken build leaves behind.
  local p
  for p in zfs-dkms zfs-dkms-git; do
    pacman -Qq "$p" &>/dev/null && return 0
  done
  return 1
}
zfs_in_use || exit 0

if [[ -n ${OMARCHY_SKIP_ZFS_KERNEL_CHECK:-} ]]; then
  echo "omarchy-zfs-kernel-compat-check: SKIPPED (OMARCHY_SKIP_ZFS_KERNEL_CHECK set)" >&2
  exit 0
fi

# Resolve which kernels to check.
#
# candidate mode reads the hook's targets from stdin (NeedsTargets). Since
# 1.2.0 the hook triggers on the path every kernel package ships,
# usr/lib/modules/<kver>/vmlinuz, so each target names the exact kernel
# version being installed and no package lookup is needed. The hook used to
# list kernel packages by name, and every list went stale: Omarchy 4.0.4 added
# five kernels it did not cover, and 4.5 added linux-omarchy-eevdf. Package
# names are still accepted for anything that calls this the old way.
#
# installed mode enumerates what is actually on disk via each module tree's
# pkgbase, so a second or third kernel is not skipped.
kernels=()   # "label<TAB>version" pairs

case "$mode" in
  installed)
    label="installed kernel"
    for _mdir in /usr/lib/modules/*/; do
      [[ -r "${_mdir}pkgbase" ]] || continue
      _pkg=$(< "${_mdir}pkgbase")
      _ver=$(pacman -Q "$_pkg" 2>/dev/null | awk '{print $2}') || true
      [[ -n $_ver ]] && kernels+=("$_pkg	$_ver")
    done
    ;;
  candidate)
    label="candidate kernel"
    # Do not block on a terminal: run by hand there is no target list.
    if [[ ! -t 0 ]]; then
      while read -r _target; do
        [[ -n $_target ]] || continue
        if [[ $_target =~ ^usr/lib/modules/([^/]+)/vmlinuz$ ]]; then
          kernels+=("kernel ${BASH_REMATCH[1]}	${BASH_REMATCH[1]}")
          continue
        fi
        _ver=$(pacman -Si "$_target" 2>/dev/null | awk '/^Version/ {print $3; exit}') || true
        [[ -n $_ver ]] && kernels+=("$_target	$_ver")
      done
    fi
    # Manual invocation, or a hook without NeedsTargets: fall back to linux.
    if (( ${#kernels[@]} == 0 )); then
      _ver=$(pacman -Si linux 2>/dev/null | awk '/^Version/ {print $3; exit}') || true
      [[ -n $_ver ]] && kernels+=("linux	$_ver")
    fi
    ;;
  *)
    echo "Usage: $(basename "$0") [installed|candidate]" >&2
    exit 2
    ;;
esac

if (( ${#kernels[@]} == 0 )); then
  echo "omarchy-zfs-kernel-compat-check: could not determine $label, skipping" >&2
  exit 0
fi

# Read zfs-dkms's META file for Linux-Maximum
meta=$(grep -hE '^Linux-Maximum:' /usr/src/zfs-*/META 2>/dev/null | awk '{print $2}' | head -1)
if [[ -z $meta ]]; then
  echo "omarchy-zfs-kernel-compat-check: could not parse zfs-dkms Linux-Maximum, skipping" >&2
  exit 0
fi

# Take the leading X.Y with a regex rather than by trimming suffixes. The old
# ${v%.*} trim assumed an Arch-style 7.0.9.arch2-1 and produced "7" from
# linux-mainline-panther-lake's 7.0rc4-2, which then compared as older than
# everything and passed by accident.
kernel_xy() {
  [[ $1 =~ ^([0-9]+)\.([0-9]+) ]] && printf '%s.%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}
kernel_xyz() {
  [[ $1 =~ ^([0-9]+\.[0-9]+\.[0-9]+) ]] && printf '%s' "${BASH_REMATCH[1]}"
}

failed=()
for entry in "${kernels[@]}"; do
  pkgname="${entry%%	*}"
  pkgver="${entry##*	}"
  target_xy=$(kernel_xy "$pkgver")
  target_xyz=$(kernel_xyz "$pkgver")
  [[ -n $target_xy ]] || continue

  # Evidence beats metadata: if DKMS has already BUILT zfs.ko for this kernel,
  # it is compatible regardless of what META claims. git-master's conservative
  # Linux-Maximum otherwise vetoes kernels the module demonstrably builds for —
  # which silently skipped every initramfs regen during ISO installs and
  # shipped an unbootable target (VM validation, 2026-08-18). A candidate given
  # by path names its exact module tree, so a reinstall counts too.
  if [[ $mode == candidate && $pkgver == "${pkgname#kernel }" ]] &&
     compgen -G "/usr/lib/modules/$pkgver/updates/dkms/zfs.ko*" >/dev/null; then
    continue
  fi
  if [[ $mode == installed && -n $target_xyz ]]; then
    _built=0
    for _mdir in /usr/lib/modules/*/; do
      [[ -e ${_mdir}updates/dkms/zfs.ko || -e ${_mdir}updates/dkms/zfs.ko.zst ]] || continue
      _mver=$(basename "$_mdir")
      [[ ${_mver%%-*} == "$target_xyz" ]] && { _built=1; break; }
    done
    (( _built )) && continue
  fi

  # OK if target_xy <= meta
  if printf '%s\n%s\n' "$target_xy" "$meta" | sort -V | tail -1 | grep -qFx "$meta"; then
    continue
  fi
  _what="$pkgname $pkgver"
  [[ $pkgname == "kernel $pkgver" ]] && _what=$pkgname
  failed+=("$_what (needs zfs Linux-Maximum >= $target_xy)")
done

(( ${#failed[@]} )) || exit 0

# Failed
{
  echo
  echo "╔════════════════════════════════════════════════════════════════════════╗"
  echo "║  ABORT: ZFS kernel compatibility check failed                          ║"
  echo "╠════════════════════════════════════════════════════════════════════════╣"
  for f in "${failed[@]}"; do
    echo "║  ${label}: ${f}"
  done
  echo "║  zfs-dkms Linux-Maximum: ${meta}"
  echo "║                                                                        ║"
  echo "║  Building zfs against this kernel will fail.                           ║"
  echo "║  Proceeding would leave the system unbootable on next restart.         ║"
  echo "║                                                                        ║"
  echo "║  To fix, update ZFS to a release whose Linux-Maximum covers this       ║"
  echo "║  kernel, in a transaction of its own, then retry. This check reads     ║"
  echo "║  the ZFS installed now, so updating both at once still stops here:     ║"
  echo "║    yay -S aur/zfs-dkms aur/zfs-utils                                   ║"
  echo "║  Keep the aur/ prefix. [archzfs] carries an older zfs-dkms, and        ║"
  echo "║  without the prefix pacman and yay both prefer the repo copy.          ║"
  echo "║                                                                        ║"
  echo "║  Omarchy 4.5 installs linux-omarchy itself and makes it the default,   ║"
  echo "║  so declining this kernel is no longer an option on Omarchy.           ║"
  echo "║                                                                        ║"
  echo "║  To bypass (DANGEROUS, may produce an unbootable system):              ║"
  echo "║    OMARCHY_SKIP_ZFS_KERNEL_CHECK=1 <command>                           ║"
  echo "╚════════════════════════════════════════════════════════════════════════╝"
} >&2
exit 1
