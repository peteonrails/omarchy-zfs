#!/bin/bash

# omarchy:summary=Ensure the ZFS mkinitcpio hook survives omarchy/pacman upgrades.
# omarchy:requires-sudo=true
#
# Why this exists: `omarchy update` runs
#   pacman -Syu --overwrite '*/etc/mkinitcpio.conf.d/omarchy_hooks.conf'
# every time, which re-clobbers omarchy's HOOKS drop-in with the stock
# (zfs-less) version. A static one-time edit would be silently undone,
# and the kernel package's own mkinitcpio hook would then regenerate an
# initramfs WITHOUT the zfs module -> unbootable root.
#
# Rather than fight over ownership of omarchy_hooks.conf (which produces
# .pacnew churn), we derive the correct HOOKS line from whatever
# omarchy_hooks.conf currently says and write it into OUR OWN drop-in that
# sorts lexically after it (zz-*), so our HOOKS= reassignment wins. This
# means upstream additions to the hook list are inherited automatically --
# we only guarantee that `zfs` lands before `filesystems`.
#
# Invoked by:
#   - zz-omarchy-zfs-ensure-mkinitcpio.hook (PostTransaction, runs last)
#   - omarchy-zfs.install (once, at package install/upgrade)

set -euo pipefail

# Testability seams (also useful from the ISO/chroot and .install contexts):
#   OMARCHY_ZFS_CONFD    override /etc/mkinitcpio.conf.d
#   OMARCHY_ZFS_CONF     override /etc/mkinitcpio.conf
#   OMARCHY_ZFS_DRYRUN=1 compute + write the drop-in but skip initramfs/ZBM regen
CONFD="${OMARCHY_ZFS_CONFD:-/etc/mkinitcpio.conf.d}"
MAIN="${OMARCHY_ZFS_CONF:-/etc/mkinitcpio.conf}"
DRYRUN="${OMARCHY_ZFS_DRYRUN:-0}"

# Non-ZFS systems never touch initramfs from here (skipped under dry-run so the
# transform can be exercised on any host).
if [[ "$DRYRUN" != "1" ]]; then
  if ! command -v findmnt &>/dev/null; then
    exit 0
  fi
  if [[ "$(findmnt -n -o FSTYPE / 2>/dev/null || true)" != "zfs" ]]; then
    exit 0
  fi
fi

STOCK="$CONFD/omarchy_hooks.conf"
OURS="$CONFD/zz-omarchy-zfs.conf"

# Derive the EFFECTIVE hooks by evaluating the config chain exactly the way
# mkinitcpio does: main conf, then conf.d drop-ins in sort order, skipping our
# own. Never text-scrape a HOOKS= line: omarchy_hooks.conf contains a second,
# conditional `HOOKS=("${_omarchy_hooks[@]}")` reassignment (its NVIDIA kms
# filter), and grabbing that line verbatim produced HOOKS=(zfs) — an
# initramfs with no /init and an unbootable install (ISO VM validation,
# 2026-08-18).
mapfile -t hooks < <(
  bash --norc --noprofile -c '
    set +e
    HOOKS=()
    [[ -r "$1" ]] && source "$1" &>/dev/null
    for f in "$2"/*.conf; do
      [[ -e "$f" ]] || continue
      [[ "$(basename "$f")" == zz-omarchy-zfs.conf ]] && continue
      source "$f" &>/dev/null
    done
    printf "%s\n" "${HOOKS[@]}"
  ' _ "$MAIN" "$CONFD"
)

if (( ${#hooks[@]} == 0 )); then
  echo "omarchy-zfs-ensure-mkinitcpio: could not derive HOOKS, using a sane default" >&2
  hooks=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
fi

# Canonicalize the hook list unconditionally: drop every existing zfs (so we
# never leave a duplicate), then insert a single zfs right before filesystems
# (or append if filesystems is absent). Idempotent -- a list that's already
# correct comes out unchanged.
new_hooks=()
inserted=0
for h in "${hooks[@]}"; do
  [[ "$h" == "zfs" ]] && continue
  if [[ "$h" == "filesystems" && $inserted -eq 0 ]]; then
    new_hooks+=("zfs")
    inserted=1
  fi
  new_hooks+=("$h")
done
(( inserted == 0 )) && new_hooks+=("zfs")

# An initramfs without an init system has no /init and cannot boot. Refuse
# to write a hook list that lacks one, whatever the derivation said.
case " ${new_hooks[*]} " in
  *" base "* | *" systemd "*) ;;
  *)
    echo "omarchy-zfs-ensure-mkinitcpio: derived hook list looks broken (${new_hooks[*]}); using a sane default" >&2
    new_hooks=(base udev autodetect microcode modconf kms keyboard keymap consolefont block zfs filesystems fsck)
    ;;
esac

new_line="HOOKS=(${new_hooks[*]})"

# Write our drop-in only if content would change (avoid needless regen).
desired="# Managed by omarchy-zfs. Sorts after omarchy_hooks.conf so this
# HOOKS= reassignment wins, guaranteeing 'zfs' loads before 'filesystems'.
# Do not edit by hand -- regenerated by omarchy-zfs-ensure-mkinitcpio.
$new_line"

# If our drop-in already matches what we'd write, the initramfs already
# carries the zfs hook -> skip the (expensive) regen. This makes the
# PostTransaction hook a cheap no-op on the common case where nothing
# clobbered omarchy_hooks.conf.
if [[ -r "$OURS" && "$(cat "$OURS")" == "$desired" ]]; then
  exit 0
fi

mkdir -p "$CONFD"
printf '%s\n' "$desired" > "$OURS"

echo "omarchy-zfs-ensure-mkinitcpio: wrote $OURS"
echo "  $new_line"

if [[ "$DRYRUN" == "1" ]]; then
  echo "omarchy-zfs-ensure-mkinitcpio: DRYRUN set, skipping initramfs/ZBM regen"
  exit 0
fi

# Regenerate initramfs and refresh ZBM. omarchy-refresh-zbm already runs the
# kernel/zfs-dkms compat check, `mkinitcpio -P`, and generate-zbm, so defer to
# it and only fall back to the raw commands if it isn't on PATH.
if command -v omarchy-refresh-zbm &>/dev/null; then
  omarchy-refresh-zbm
else
  if command -v omarchy-zfs-kernel-compat-check &>/dev/null; then
    omarchy-zfs-kernel-compat-check installed || {
      echo "omarchy-zfs-ensure-mkinitcpio: kernel/zfs-dkms incompatible, skipping regen" >&2
      exit 0
    }
  fi
  echo "Regenerating initramfs"
  mkinitcpio -P
  if command -v generate-zbm &>/dev/null; then
    echo "Regenerating ZFSBootMenu"
    generate-zbm
  fi
fi
